if(NOT DEFINED W3D_TEMPLATE_SOURCE OR NOT DEFINED W3D_TEMPLATE_DEST)
    message(FATAL_ERROR "W3D_TEMPLATE_SOURCE and W3D_TEMPLATE_DEST are required")
endif()

foreach(template animation controls platformer audio)
    set(source_dir "${W3D_TEMPLATE_SOURCE}/${template}")
    set(dest_dir "${W3D_TEMPLATE_DEST}/${template}")
    if(NOT IS_DIRECTORY "${source_dir}")
        message(FATAL_ERROR "Project template directory is missing: ${source_dir}")
    endif()
    file(MAKE_DIRECTORY "${dest_dir}")
    file(GLOB template_files LIST_DIRECTORIES false "${source_dir}/*")
    foreach(template_file IN LISTS template_files)
        file(COPY "${template_file}" DESTINATION "${dest_dir}")
    endforeach()
endforeach()
