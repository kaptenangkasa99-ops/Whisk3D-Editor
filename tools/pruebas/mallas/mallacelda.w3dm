W3DMESH 1
# malla de Whisk3D. texto por lineas, indices base 0.
# MAYUSCULA abre bloque (cierra END) | minuscula = directiva | espacio = dato
requiere V F
nombre MallaCelda
puntos 12
esquinas 12
caras 4
suave 0
uvactiva 0

# los PUNTOS de control (x y z)
V 12 punto
 -4 0 -1
 -3 0 -1
 -3.5 0 1
 -2 0 -1
 -1 0 -1
 -1.5 0 1
 1 0 -1
 2 0 -1
 1.5 0 1
 3 0 -1
 4 0 -1
 3.5 0 1
END

# caras: <lados> y sus puntos, en orden alrededor del poligono
F 4 cara
 3 0 1 2
 3 3 4 5
 3 6 7 8
 3 9 10 11
END

# normal por esquina (x y z enteros, escala 1/127)
NRM 12 esquina
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
 0 127 0
END

UV 12 esquina nombre=UVMap
 0 1
 1 1
 0.5 0
 0 1
 1 1
 0.5 0
 0 1
 1 1
 0.5 0
 0 1
 1 1
 0.5 0
END

# partes de malla (el material vive en la escena: se referencia POR NOMBRE)
PARTS 1 global
 Mesh
END
