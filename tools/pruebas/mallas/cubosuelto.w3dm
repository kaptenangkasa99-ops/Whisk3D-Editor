W3DMESH 1
# malla de Whisk3D. texto por lineas, indices base 0.
# MAYUSCULA abre bloque (cierra END) | minuscula = directiva | espacio = dato
requiere V F
nombre CuboSuelto
puntos 8
esquinas 36
caras 12
suave 0
uvactiva 0
colactiva 0

# los PUNTOS de control (x y z)
V 8 punto
 -1.5 -1.5 -1.5
 -1.5 -1.5 1.5
 1.5 -1.5 1.5
 1.5 -1.5 -1.5
 -1.5 1.5 -1.5
 1.5 1.5 -1.5
 1.5 1.5 1.5
 -1.5 1.5 1.5
END

# caras: <lados> y sus puntos, en orden alrededor del poligono
F 12 cara
 3 0 1 2
 3 0 2 3
 3 4 5 6
 3 4 6 7
 3 1 7 6
 3 1 6 2
 3 3 5 4
 3 3 4 0
 3 2 6 5
 3 2 5 3
 3 0 4 7
 3 0 7 1
END

# normal por esquina (x y z enteros, escala 1/127)
